  "timezone": "",
  "title": "SecureAgentRAG — RAG Pipeline",
  "uid": "secureagentrag-rag",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Pipeline latency (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "sar-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(rag_pipeline_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(rag_pipeline_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(rag_pipeline_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pipeline requests by outcome (rate/5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "sar-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rag_pipeline_requests_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Inference routed by provider",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "sar-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(inference_routed_by_provider_total[1h])) by (provider)",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Guardrails blocks by reason (rate/5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "sar-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(guardrails_blocked_total[5m])) by (gate, reason)",
          "legendFormat": "{{gate}}:{{reason}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Faithfulness sentences dropped (cumulative)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "sar-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "refId": "A", "expr": "sum(faithfulness_dropped_total)", "legendFormat": "dropped" }
      ]
    },
    {
      "id": 6,
      "title": "HTTP request rate by handler",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "sar-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total[5m])) by (handler)",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "HTTP latency p95 by handler",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "sar-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, handler))",
          "legendFormat": "{{handler}}"
        }
      ]
    }
  ]
}
