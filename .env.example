# ==============================================================================
# SecureAgentRAG — Environment Configuration
# ==============================================================================
# Copy this file to `.env` and adjust values for your environment.
# All variables are prefixed with SAR_ to avoid collisions.

# ── Application ──────────────────────────────────────────────────────────────
SAR_APP_NAME=SecureAgentRAG
SAR_DEBUG=false
SAR_LOG_LEVEL=INFO

# ── Qdrant Vector Store ──────────────────────────────────────────────────────
SAR_QDRANT_URL=http://localhost:6333
SAR_QDRANT_COLLECTION=documents
# SAR_QDRANT_API_KEY=

# ── Ollama / LLM ─────────────────────────────────────────────────────────────
SAR_OLLAMA_URL=http://localhost:11434
SAR_LLM_MODEL=qwen3:8b
SAR_EMBEDDING_MODEL=bge-m3
SAR_EMBEDDING_DIM=1024

# ── Chunking ─────────────────────────────────────────────────────────────────
SAR_CHUNK_SIZE=1000
SAR_CHUNK_OVERLAP=200

# ── Retrieval ────────────────────────────────────────────────────────────────
SAR_TOP_K=10
SAR_RERANK_TOP_K=5
SAR_RELEVANCE_THRESHOLD=0.7

# ── Inference Providers ──────────────────────────────────────────────────────
SAR_DEFAULT_PROVIDER=ollama
# SAR_CLOUD_PROVIDER=groq
# SAR_GROQ_API_KEY=
# SAR_OPENAI_API_KEY=
# SAR_ANTHROPIC_API_KEY=

# ── RBAC ─────────────────────────────────────────────────────────────────────
SAR_ENABLE_RBAC=true

# ── Reranker (opt-in — downloads ~600MB cross-encoder on first use) ──────────
# SAR_ENABLE_RERANKER=true

# ── Persistent LangGraph Checkpointing (opt-in) ──────────────────────────────
# Enable SQLite (default) / Postgres checkpointing. Off by default so tests stay
# fast and pytest-asyncio's per-test loops don't collide with aiosqlite.
# SAR_USE_PERSISTENT_CHECKPOINTER=true
# SAR_POSTGRES_URL=postgresql://sar_user:sar_password@localhost:5432/secureagentrag

# ── Redis (distributed rate limiting + query caching) ────────────────────────
# SAR_REDIS_URL=redis://localhost:6379/0
# SAR_USE_REDIS_RATE_LIMITER=false

# ── Observability (Arize Phoenix) ────────────────────────────────────────────
# SAR_PHOENIX_ENDPOINT=http://localhost:6006

# ── Storage paths (absolute paths recommended for production) ────────────────
# SAR_AUDIT_LOG_DIR=/var/lib/secureagentrag/audit_logs
# SAR_CONVERSATION_DIR=/var/lib/secureagentrag/conversations
# SAR_CHECKPOINT_DB_PATH=/var/lib/secureagentrag/checkpoints.sqlite
# SAR_SPARSE_BACKEND=bm25  # "bm25" (default, no deps) or "splade" (needs sentence-transformers)

# ── Pipeline SLO ─────────────────────────────────────────────────────────────
# Hard wall-clock budget for a single RAG run. 0 disables.
# SAR_REQUEST_TIMEOUT_S=60

# ── Citation faithfulness gate (NLI) ─────────────────────────────────────────
# Per-sentence entailment check after synthesis. Off by default — one extra
# LLM call per cited sentence (parallel). Modes: "flag" (default, annotate)
# or "drop" (remove unsupported sentences).
# SAR_FAITHFULNESS_GATE_ENABLED=true
# SAR_FAITHFULNESS_GATE_MODE=flag
# SAR_FAITHFULNESS_THRESHOLD=0.7
# SAR_FAITHFULNESS_MAX_CONCURRENT=4

# ── Authentication (HS256 JWT) ───────────────────────────────────────────────
# Set SAR_JWT_SECRET to enable signed bearer tokens on the FastAPI / MCP
# surfaces. With this unset the dev fallback accepts unsigned base64 tokens
# (logs a warning on every request — do not ship to prod). Use a long random
# value; rotate via key-versioning out-of-band.
# SAR_JWT_SECRET=change-me-to-a-long-random-string
# SAR_JWT_ISSUER=secureagentrag
# SAR_JWT_AUDIENCE=secureagentrag-api
# SAR_JWT_TTL_SECONDS=3600
# SAR_JWT_ALGORITHM=HS256

# ── Guardrails escalation backend ────────────────────────────────────────────
# When SAR_GUARDRAILS_STRICT=true, regex-passed queries are sent to one of:
#   "llm"        — legacy SAFE/UNSAFE prompt on qwen3:8b (default)
#   "llamaguard" — Meta LlamaGuard 3 via Ollama. Pull with:
#                  ollama pull llama-guard3:8b
# Maps S1-S14 LlamaGuard categories into guardrails_reason.
# SAR_GUARDRAILS_STRICT=true
# SAR_GUARDRAILS_BACKEND=llamaguard
# SAR_LLAMAGUARD_MODEL=llama-guard3:8b

# ── Reranker mode ────────────────────────────────────────────────────────────
# Options: none | cross_encoder | colbert | fine_tuned
# "fine_tuned" requires a checkpoint produced by scripts/train_reranker.py
# at SAR_FINETUNED_RERANKER_PATH (default data/checkpoints/reranker-domain-v1).
# SAR_RERANKER_TYPE=cross_encoder
# SAR_RERANKER_CHECKPOINT=BAAI/bge-reranker-v2-m3
# SAR_COLBERT_CHECKPOINT=colbert-ir/colbertv2.0
# SAR_FINETUNED_RERANKER_PATH=data/checkpoints/reranker-domain-v1

# ── Sparse vector backend ────────────────────────────────────────────────────
# Options: bm25 (default, zero deps) | splade (requires [embeddings-local]).
# Sparse is stored alongside dense in the same Qdrant collection — RBAC is
# preserved at the vector layer with no post-fusion re-check.
# SAR_SPARSE_BACKEND=splade
# SAR_SPARSE_MODEL=naver/splade-cocondenser-ensembledistil
# SAR_SPARSE_VECTOR_NAME=sparse

# ── JWKS-based RS256 verification (production auth) ──────────────────────────
# Flip JWT mode and point at the IdP's JWKS endpoint. Keep SAR_JWT_SECRET
# unset in RS256 mode — verification uses the public keys from JWKS.
# SAR_JWT_ALGORITHM=RS256
# SAR_JWKS_URL=http://keycloak:8080/realms/secureagentrag/protocol/openid-connect/certs
# SAR_JWKS_CACHE_TTL_SECONDS=300

# ── BYOK demo mode (production launch P6, see launch-plan/03-backend-byok.md) ─
# Turns the FastAPI surface into a public-demo backend:
#   - Per-request LLM key extracted from X-User-LLM-Key / X-User-Provider headers
#   - Per-session Qdrant collections (documents_sess_<session_id>)
#   - Owner-key fallback gated by per-IP throttle (3/hour by default)
#   - Phoenix instrumentation forcibly disabled
#   - Audit log redacts API key patterns before persist
# Off in dev/staging; on in the Hugging Face Space production image.
# SAR_BYOK_MODE=false
# SAR_BYOK_OWNER_QUOTA=3
# SAR_SESSION_TTL_HOURS=24
# SAR_CORS_ALLOW_ORIGINS=["https://secureagentrag.vercel.app"]

# ── Qdrant Cloud (production vector store, see launch-plan/04-hf-space-deploy.md)
# Free-tier 1 GB cluster — no credit card required at signup.
# Set these via HF Space "secrets" panel, not committed values.
# SAR_QDRANT_URL=https://<uuid>.us-east.aws.cloud.qdrant.io
# SAR_QDRANT_API_KEY=<rotate-via-cloud.qdrant.io>
