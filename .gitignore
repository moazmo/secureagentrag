# ==============================================================================
# SecureAgentRAG .gitignore
# ==============================================================================

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Virtual Environments ─────────────────────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── Distribution / Packaging ─────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── Linting / Type Checking ──────────────────────────────────────────────────
.ruff_cache/
.mypy_cache/
.dmypy.json

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Environment ──────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Data / Storage (local volumes) ──────────────────────────────────────────
qdrant_storage/
ollama_data/
data/*
# Exception: UI-gate evidence is the formal PR acceptance artifact per AGENTS.md.
!data/agent_evidence/
# But not the bulky downloaded PDFs — those are reproducible from the
# URLs in scripts/h2_gate.py and the README.
data/agent_evidence/real_corpus/
audit_logs/
conversations/

# ── Test scratch output ──────────────────────────────────────────────────────
test_output*.txt
test_results*.txt
test_run_output*.txt
test_fixes_output*.txt
test_final_output*.txt
test_final_summary*.txt

# ── Evaluation runtime artifacts ─────────────────────────────────────────────
evaluation/results/

# ── Local working dir (notes, scratch, untracked artifacts) ──────────────────
private/
INTERVIEW_DEFENSE.md
NOTES.md
TODO.md

# HF Space deploy staging dir (generated by scripts/deploy_hf_space.py)
.hf-deploy-staging/

# ── OS Files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Jupyter / IPython ────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Misc ─────────────────────────────────────────────────────────────────────
*.log
